{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "animations": true,
  "mouse": true,
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "grouping": "auto",
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "view": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "keybinds": {
    "command.palette.show": "ctrl+p,ctrl+k",
    "session.sidebar.toggle": "<leader>b,ctrl+b",
    "diff.open": "<leader>d",
    "terminal.toggle": "<leader>t,ctrl+`"
  }
}
