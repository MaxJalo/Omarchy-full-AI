[Plymouth Theme]
Name=Maxjalo Glass
Description=macOS Liquid Glass splash & LUKS unlock theme matching maxjalo.lock and SDDM
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/maxjalo-glass
ScriptFile=/usr/share/plymouth/themes/maxjalo-glass/maxjalo-glass.script
ConsoleLogBackgroundColor=0x090b0e
MonospaceFont=JetBrainsMono Nerd Font 11
Font=Liberation Sans 11
